package idris2-Boole-Wiki
version = 0.1.0
executable = boolewiki

depends = base, idris2-QuickCheck, idris2-Multiset, idris2-Boole, idris2-Universe, idris2-chromogeometry

sourcedir = "Library/Wiki"

modules = Logic_Explainer,
          Logic_Repetition,
          Bit_vexel,
          Boole_Function,
          Boole_mobius_transform,
          Engine_Verification,
          Information_As_Probability,
          Cross_Entropy_And_Compression,
          Hehner_Normalization,
          Functional_Probability,
          Boole_Last_Challenge,
          Lifted_Polynumbers,
          Logic_Lifted,
          Probability_Bounds,
          Hehner_Quantifiers

main = Main
